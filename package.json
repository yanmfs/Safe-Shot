{
  "name": "safeshot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "pretest": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.16",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "description": "Hide CPF, phone numbers, Pix keys and other sensitive data in screenshots before you share them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanmfs/Safe-Shot.git"
  },
  "keywords": [
    "screenshot",
    "privacy",
    "redaction",
    "ocr",
    "brazil",
    "tauri",
    "desktop"
  ],
  "packageManager": "pnpm@12.18.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "tesseract.js"
    ]
  }
}
